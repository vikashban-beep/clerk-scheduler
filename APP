<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Court Clerk Department Scheduler</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @media print {
            .no-print { display: none !important; }
            body { background: white !important; color: black !important; }
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col">

    <!-- Top Navigation Header -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 py-3 flex flex-wrap justify-between items-center gap-4">
            <div class="flex items-center gap-3">
                <div class="bg-indigo-600 text-white p-2 rounded-xl shadow-md font-bold">📅</div>
                <div>
                    <h1 class="text-xl font-bold text-slate-900">Court Clerk Scheduler</h1>
                    <p class="text-xs text-slate-500">LATH • MOD • STK • CVA On-Call (Live Cloud Sync)</p>
                </div>
            </div>

            <!-- Views Switcher -->
            <div class="flex items-center gap-2 flex-wrap">
                <div class="bg-slate-100 p-1 rounded-lg flex items-center gap-1 text-sm font-medium">
                    <button onclick="switchView('week')" id="btn-view-week" class="px-3 py-1.5 rounded-md bg-white shadow-sm text-indigo-600 transition">Week Board</button>
                    <button onclick="switchView('month')" id="btn-view-month" class="px-3 py-1.5 rounded-md text-slate-600 hover:text-slate-950 transition">Month Calendar</button>
                    <button onclick="switchView('request')" id="btn-view-request" class="px-3 py-1.5 rounded-md text-slate-600 hover:text-slate-950 transition">Request / Split Shift</button>
                    <button onclick="promptManager()" id="btn-view-manager" class="px-3 py-1.5 rounded-md text-slate-600 hover:text-slate-950 transition flex items-center gap-1">
                        🔒 Manager Queue <span id="pending-badge" class="bg-amber-100 text-amber-800 text-xs px-1.5 py-0.5 rounded-full font-bold">0</span>
                    </button>
                    <button onclick="switchView('setup')" id="btn-view-setup" class="px-3 py-1.5 rounded-md text-slate-600 hover:text-slate-950 transition">Setup</button>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-7xl mx-auto px-4 py-6 flex-1 w-full space-y-6">

        <!-- WEEK BOARD VIEW -->
        <section id="view-week" class="space-y-6">
            <div id="staffing-warning-banner" class="hidden bg-rose-50 border border-rose-200 text-rose-800 p-4 rounded-2xl text-xs font-semibold flex items-center justify-between shadow-sm">
                <div class="flex items-center gap-2">
                    <span class="text-base">⚠️</span>
                    <div>
                        <strong class="text-sm">Staffing Minimum Alert:</strong> One or more sites are below minimum required staffing for this week.
                        <div id="warning-details" class="text-rose-600 font-normal mt-0.5"></div>
                    </div>
                </div>
            </div>

            <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-wrap justify-between items-center gap-4">
                <div class="flex items-center gap-3">
                    <button onclick="navigateWeek(-1)" class="p-2 border rounded-xl hover:bg-slate-50 text-slate-600 transition font-bold">&larr;</button>
                    <div>
                        <span id="current-week-label" class="text-lg font-bold text-slate-900">Week of ...</span>
                        <p class="text-xs text-slate-500">Monday to Friday schedule</p>
                    </div>
                    <button onclick="navigateWeek(1)" class="p-2 border rounded-xl hover:bg-slate-50 text-slate-600 transition font-bold">&rarr;</button>
                    <button onclick="jumpToToday()" class="text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium px-3 py-2 rounded-xl transition">This Week</button>
                </div>

                <div class="flex items-center gap-3 flex-wrap">
                    <div class="flex items-center gap-2 text-xs">
                        <label class="font-semibold text-slate-500 uppercase">Site Filter:</label>
                        <select id="site-filter" onchange="renderWeekBoard()" class="border border-slate-300 rounded-xl px-3 py-1.5 text-xs focus:ring-2 focus:ring-indigo-500 outline-none font-medium">
                            <option value="ALL">All Sites</option>
                            <option value="LATH">LATH (Lathrop)</option>
                            <option value="MOD">MOD (Modesto)</option>
                            <option value="STK">STK (Stockton)</option>
                        </select>
                    </div>
                    <button onclick="switchView('request')" class="bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-xs px-4 py-2 rounded-xl shadow-sm transition">
                        + Request / Split Shift
                    </button>
                    <button onclick="window.print()" class="no-print bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs px-3 py-2 rounded-xl font-medium transition">
                        Print / PDF
                    </button>
                </div>
            </div>

            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-x-auto">
                <table class="w-full text-left border-collapse min-w-[900px]">
                    <thead>
                        <tr class="bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-600 uppercase tracking-wider">
                            <th class="p-4 w-48">Staff Member</th>
                            <th class="p-4 text-center" id="th-day-0">Mon</th>
                            <th class="p-4 text-center" id="th-day-1">Tue</th>
                            <th class="p-4 text-center" id="th-day-2">Wed</th>
                            <th class="p-4 text-center" id="th-day-3">Thu</th>
                            <th class="p-4 text-center" id="th-day-4">Fri</th>
                            <th class="p-4 text-center w-28">Weekly Hours</th>
                        </tr>
                    </thead>
                    <tbody id="schedule-grid-body" class="divide-y divide-slate-100 text-sm">
                        <!-- Populated via JS -->
                    </tbody>
                </table>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-3">
                    <h3 class="font-bold text-slate-900 text-sm flex items-center gap-2">📞 On-Call Pool Rotation (CVA)</h3>
                    <div id="on-call-tracker" class="text-xs space-y-1 text-slate-600"></div>
                </div>
                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-3">
                    <h3 class="font-bold text-slate-900 text-sm flex items-center gap-2">⚖️ Minimum Staffing Requirements</h3>
                    <div class="text-xs space-y-1 text-slate-600">
                        <p>• <strong>LATH:</strong> Min 3 staff / 20 hours daily</p>
                        <p>• <strong>MOD:</strong> Min 2 staff / 8 hours daily</p>
                        <p>• <strong>STK:</strong> Min 2 staff / 16 hours daily</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- MONTH VIEW -->
        <section id="view-month" class="space-y-6 hidden">
            <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex justify-between items-center">
                <div class="flex items-center gap-3">
                    <button onclick="navigateMonth(-1)" class="p-2 border rounded-xl hover:bg-slate-50 font-bold">&larr;</button>
                    <span id="current-month-label" class="text-lg font-bold text-slate-900">Month Year</span>
                    <button onclick="navigateMonth(1)" class="p-2 border rounded-xl hover:bg-slate-50 font-bold">&rarr;</button>
                </div>
                <button onclick="jumpToCurrentMonth()" class="text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium px-3 py-2 rounded-xl">Current Month</button>
            </div>
            <div id="month-calendar-grid" class="bg-white rounded-2xl border border-slate-200 shadow-sm p-4 grid grid-cols-1 md:grid-cols-5 gap-3"></div>
        </section>

        <!-- REQUEST VIEW -->
        <section id="view-request" class="space-y-6 hidden">
            <div class="bg-white p-6 rounded-2xl shadow-sm max-w-xl mx-auto space-y-4 border border-slate-200">
                <div class="border-b pb-3">
                    <h2 class="text-lg font-semibold text-slate-800">Request Time Off, Extra Shift, or Split Shift</h2>
                    <p class="text-xs text-slate-500">Submissions go straight to the manager queue as <span class="text-amber-600 font-semibold">Pending</span>.</p>
                </div>
                
                <form onsubmit="handleRequestSubmit(event)" class="space-y-4 text-sm">
                    <div>
                        <label class="block text-xs font-semibold uppercase text-slate-500 mb-1">Staff Member</label>
                        <select id="req-person" required class="w-full border border-slate-300 rounded-xl p-2.5 text-sm focus:ring-2 focus:ring-indigo-500 outline-none"></select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase text-slate-500 mb-1">Entry Type</label>
                        <select id="req-type" onchange="toggleSplitFields()" class="w-full border border-slate-300 rounded-xl p-2.5 text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                            <option value="Vacation">Vacation / Time Off</option>
                            <option value="Sick">Sick / Call-out</option>
                            <option value="School">School</option>
                            <option value="Extra Shift">Extra Shift (Additional Coverage)</option>
                            <option value="Split Shift">Split Shift (Work across 2 sites)</option>
                        </select>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold uppercase text-slate-500 mb-1">Start Date</label>
                            <input type="date" id="req-start" required class="w-full border border-slate-300 rounded-xl p-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold uppercase text-slate-500 mb-1">End Date</label>
                            <input type="date" id="req-end" required class="w-full border border-slate-300 rounded-xl p-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                        </div>
                    </div>

                    <div id="split-shift-fields" class="hidden space-y-3 bg-indigo-50/50 p-4 rounded-xl border border-indigo-100">
                        <p class="text-xs font-bold text-indigo-900">Split Shift Configuration</p>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">First Site</label>
                                <select id="req-site-1" class="w-full border rounded-xl p-2 text-xs">
                                    <option value="LATH">LATH</option>
                                    <option value="MOD">MOD</option>
                                    <option value="STK">STK</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">First Site Times</label>
                                <input type="text" id="req-time-1" placeholder="e.g. 8a-12p" class="w-full border rounded-xl p-2 text-xs">
                            </div>
                        </div>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Second Site</label>
                                <select id="req-site-2" class="w-full border rounded-xl p-2 text-xs">
                                    <option value="MOD">MOD</option>
                                    <option value="STK">STK</option>
                                    <option value="LATH">LATH</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Second Site Times</label>
                                <input type="text" id="req-time-2" placeholder="e.g. 1p-5p" class="w-full border rounded-xl p-2 text-xs">
                            </div>
                        </div>
                    </div>

                    <div id="standard-time-fields" class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-semibold uppercase text-slate-500 mb-1">From Time (optional for partial day)</label>
                            <input type="text" id="req-time-from" placeholder="e.g. 8:00a" class="w-full border border-slate-300 rounded-xl p-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold uppercase text-slate-500 mb-1">To Time (optional for partial day)</label>
                            <input type="text" id="req-time-to" placeholder="e.g. 5:00p" class="w-full border border-slate-300 rounded-xl p-2 text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                        </div>
                    </div>

                    <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2.5 rounded-xl text-sm transition shadow-sm">
                        Submit Request
                    </button>
                </form>
            </div>
        </section>

        <!-- MANAGER QUEUE VIEW -->
        <section id="view-manager" class="space-y-6 hidden">
            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
                <h2 class="text-lg font-semibold text-slate-800 border-b pb-3 flex justify-between items-center">
                    <span>Manager Review Queue</span>
                    <span class="text-xs text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-lg">🔒 Authorized Manager</span>
                </h2>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse text-sm">
                        <thead>
                            <tr class="border-b border-slate-100 text-xs font-semibold text-slate-400 uppercase">
                                <th class="py-3 px-2">Employee</th>
                                <th class="py-3 px-2">Type & Dates</th>
                                <th class="py-3 px-2">Times / Split Details</th>
                                <th class="py-3 px-2">Status</th>
                                <th class="py-3 px-2 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="manager-table-body" class="divide-y divide-slate-100"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- SETUP VIEW -->
        <section id="view-setup" class="space-y-6 hidden">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-4">
                    <h3 class="font-bold text-slate-900">Staff Members</h3>
                    <div id="setup-staff-list" class="space-y-2 text-sm max-h-[300px] overflow-y-auto"></div>
                </div>
                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-4">
                    <h3 class="font-bold text-slate-900">Add New Employee</h3>
                    <form onsubmit="handleAddStaff(event)" class="space-y-3 text-sm">
                        <input type="text" id="new-staff-name" placeholder="Full Name" required class="w-full border rounded-xl p-2">
                        <select id="new-staff-site" class="w-full border rounded-xl p-2">
                            <option value="LATH">LATH (Lathrop)</option>
                            <option value="MOD">MOD (Modesto)</option>
                            <option value="STK">STK (Stockton)</option>
                            <option value="CVA">CVA (On-Call)</option>
                        </select>
                        <input type="text" id="new-staff-hours" placeholder="Hours (e.g. 8a-5p)" required class="w-full border rounded-xl p-2">
                        <div class="flex items-center gap-2">
                            <input type="checkbox" id="new-staff-pool">
                            <label for="new-staff-pool" class="text-xs text-slate-600 font-medium">Part of On-Call Pool</label>
                        </div>
                        <button type="submit" class="w-full bg-indigo-600 text-white py-2 rounded-xl font-medium">Add Employee</button>
                    </form>
                </div>
            </div>
        </section>

    </main>

    <!-- Core App Logic with JSONBin Cloud Sync -->
    <script>
        const BIN_ID = '6ac530b4ffd5d16053538c96';
        const API_KEY = '$2a$10$Xv5g5JQ0tXV3lAMNowQcel8D1G5xRyWUNnaf25uDmQ/rvxJQBFl.';

        let currentView = 'week';
        let managerUnlocked = false;
        let currentViewDate = new Date();
        let currentMonthDate = new Date();

        let staffList = [];
        let requests = [];

        // Load data from JSONBin Cloud
        async function loadCloudData() {
            try {
                let res = await fetch(`https://api.jsonbin.io/v3/b/${BIN_ID}/latest`, {
                    headers: { 'X-Master-Key': API_KEY }
                });
                let json = await res.json();
                staffList = json.record.staff || [];
                requests = json.record.requests || [];
            } catch (err) {
                console.error('Error loading cloud data, falling back to defaults', err);
            }
            populateRequestDropdown();
            renderWeekBoard();
        }

        // Save data to JSONBin Cloud
        async function saveCloudData() {
            try {
                await fetch(`https://api.jsonbin.io/v3/b/${BIN_ID}`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Master-Key': API_KEY
                    },
                    body: JSON.stringify({ staff: staffList, requests: requests })
                });
            } catch (err) {
                console.error('Error saving cloud data', err);
            }
        }

        window.addEventListener('DOMContentLoaded', () => {
            initWeekStart();
            loadCloudData();
        });

        function switchView(view) {
            ['week', 'month', 'request', 'manager', 'setup'].forEach(v => {
                const sec = document.getElementById(`view-${v}`);
                if (sec) sec.classList.add('hidden');
                const btn = document.getElementById(`btn-view-${v}`);
                if (btn) btn.classList.remove('bg-white', 'shadow-sm', 'text-indigo-600');
            });
            const targetSec = document.getElementById(`view-${view}`);
            if (targetSec) targetSec.classList.remove('hidden');
            const activeBtn = document.getElementById(`btn-view-${view}`);
            if (activeBtn) activeBtn.classList.add('bg-white', 'shadow-sm', 'text-indigo-600');

            currentView = view;
            if (view === 'week') renderWeekBoard();
            if (view === 'month') renderMonthView();
            if (view === 'manager') renderManagerQueue();
            if (view === 'setup') renderSetupStaff();
        }

        function promptManager() {
            if (managerUnlocked) {
                switchView('manager');
                return;
            }
            const pwd = prompt("Enter Manager Password:");
            if (pwd === "admin123") {
                managerUnlocked = true;
                switchView('manager');
            } else if (pwd !== null) {
                alert("Incorrect password.");
            }
        }

        function toggleSplitFields() {
            const type = document.getElementById('req-type').value;
            const splitFields = document.getElementById('split-shift-fields');
            const standardFields = document.getElementById('standard-time-fields');
            if (type === 'Split Shift') {
                splitFields.classList.remove('hidden');
                standardFields.classList.add('hidden');
            } else {
                splitFields.classList.add('hidden');
                standardFields.classList.remove('hidden');
            }
        }

        function initWeekStart() {
            if (currentViewDate.getDay() === 0 || currentViewDate.getDay() === 6) {
                const day = currentViewDate.getDay();
                currentViewDate.setDate(currentViewDate.getDate() + (day === 0 ? 1 : 2));
            }
            const dayOfWeek = currentViewDate.getDay();
            currentViewDate.setDate(currentViewDate.getDate() - dayOfWeek + (dayOfWeek === 0 ? -6 : 1));
        }

        function getWeekDates() {
            const monday = new Date(currentViewDate);
            const dates = [];
            const dayNames = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'];
            for (let i = 0; i < 5; i++) {
                const d = new Date(monday);
                d.setDate(monday.getDate() + i);
                const y = d.getFullYear();
                const m = String(d.getMonth() + 1).padStart(2, '0');
                const day = String(d.getDate()).padStart(2, '0');
                dates.push({
                    dayName: dayNames[i],
                    label: `${dayNames[i]} ${d.getMonth()+1}/${d.getDate()}`,
                    dateStr: `${y}-${m}-${day}`
                });
            }
            return dates;
        }

        function renderWeekBoard() {
            const weekDates = getWeekDates();
            const startLbl = new Date(weekDates[0].dateStr + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
            const endLbl = new Date(weekDates[4].dateStr + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
            document.getElementById('current-week-label').innerText = `Week of ${startLbl} – ${endLbl}`;

            weekDates.forEach((d, idx) => {
                const th = document.getElementById(`th-day-${idx}`);
                if (th) th.innerText = d.label;
            });

            const siteFilter = document.getElementById('site-filter').value;
            const filteredStaff = staffList.filter(s => siteFilter === 'ALL' || s.site === siteFilter || requests.some(r => r.name === s.name && r.status === 'Approved' && (r.site1 === siteFilter || r.site2 === siteFilter)));

            const tbody = document.getElementById('schedule-grid-body');
            if (!tbody) return;
            tbody.innerHTML = '';

            let staffingIssues = [];
            let onCallTrackerHtml = '';
            const poolStaff = staffList.filter(s => s.pool);

            weekDates.forEach((d, dIdx) => {
                let dayStaffCounts = { LATH: 0, MOD: 0, STK: 0 };
                
                staffList.forEach(staff => {
                    const approved = requests.find(r => r.name === staff.name && r.status === 'Approved' && d.dateStr >= r.start && d.dateStr <= r.end);
                    let isOff = false;
                    if (approved && (approved.type === 'Vacation' || approved.type === 'Sick') && (!approved.timeFrom || !approved.timeTo)) {
                        isOff = true;
                    }
                    if (!isOff) {
                        if (approved && approved.type === 'Split Shift') {
                            if (dayStaffCounts[approved.site1] !== undefined) dayStaffCounts[approved.site1]++;
                            if (dayStaffCounts[approved.site2] !== undefined) dayStaffCounts[approved.site2]++;
                        } else {
                            if (dayStaffCounts[staff.site] !== undefined) dayStaffCounts[staff.site]++;
                        }
                    }
                });

                if (dayStaffCounts['LATH'] < 3) staffingIssues.push(`${d.label}: LATH has ${dayStaffCounts['LATH']} staff (Min 3 required)`);
                if (dayStaffCounts['MOD'] < 2) staffingIssues.push(`${d.label}: MOD has ${dayStaffCounts['MOD']} staff (Min 2 required)`);
                if (dayStaffCounts['STK'] < 2) staffingIssues.push(`${d.label}: STK has ${dayStaffCounts['STK']} staff (Min 2 required)`);

                if (poolStaff.length > 0) {
                    const assignedOnCall = poolStaff[(dIdx) % poolStaff.length].name;
                    onCallTrackerHtml += `<div><strong>${d.dayName}:</strong> ${assignedOnCall}</div>`;
                }
            });

            document.getElementById('on-call-tracker').innerHTML = onCallTrackerHtml || '<div>No pool staff available</div>';

            const warningBanner = document.getElementById('staffing-warning-banner');
            if (staffingIssues.length > 0) {
                warningBanner.classList.remove('hidden');
                document.getElementById('warning-details').innerHTML = staffingIssues.slice(0, 3).join(' • ');
            } else {
                warningBanner.classList.add('hidden');
            }

            filteredStaff.forEach(staff => {
                let row = `<tr class="border-b hover:bg-slate-50"><td class="p-3 font-medium text-xs"><strong>${staff.name}</strong><br><span class="text-slate-500">${staff.site} • ${staff.hours}</span></td>`;
                
                let weeklyHours = 0;
                weekDates.forEach(d => {
                    const approved = requests.find(r => r.name === staff.name && r.status === 'Approved' && d.dateStr >= r.start && d.dateStr <= r.end);
                    
                    let badgeColor = "bg-emerald-100 text-emerald-800";
                    let badgeText = "Working";
                    let timeSubtext = staff.hours;
                    let hrs = 8;

                    if (approved) {
                        const hasPartialTimes = approved.timeFrom && approved.timeTo;

                        if (approved.type === 'Split Shift') {
                            badgeColor = "bg-indigo-100 text-indigo-800";
                            badgeText = `Split (${approved.site1}/${approved.site2})`;
                            timeSubtext = `${approved.site1}: ${approved.time1} | ${approved.site2}: ${approved.time2}`;
                            hrs = 8;
                        } else if (approved.type === 'Extra Shift') {
                            badgeColor = "bg-emerald-700 text-white";
                            badgeText = "Extra Shift";
                            timeSubtext = `${approved.timeFrom}-${approved.timeTo}`;
                            hrs = 8;
                        } else if (approved.type === 'Vacation') {
                            if (hasPartialTimes) {
                                badgeColor = "bg-amber-100 text-amber-800";
                                badgeText = "Vacation (Partial)";
                                timeSubtext = `${approved.timeFrom} - ${approved.timeTo}`;
                                hrs = 6;
                            } else {
                                badgeColor = "bg-blue-100 text-blue-800";
                                badgeText = "Vacation";
                                timeSubtext = "Off";
                                hrs = 0;
                            }
                        } else if (approved.type === 'Sick') {
                            if (hasPartialTimes) {
                                badgeColor = "bg-amber-100 text-amber-800";
                                badgeText = "Sick (Partial)";
                                timeSubtext = `${approved.timeFrom} - ${approved.timeTo}`;
                                hrs = 6;
                            } else {
                                badgeColor = "bg-rose-100 text-rose-800";
                                badgeText = "Sick/Off";
                                timeSubtext = "Off";
                                hrs = 0;
                            }
                        } else if (approved.type === 'School') {
                            badgeColor = "bg-purple-100 text-purple-800";
                            badgeText = "School";
                            timeSubtext = hasPartialTimes ? `${approved.timeFrom} - ${approved.timeTo}` : (approved.timeFrom || '8a-5p');
                            hrs = 4;
                        }
                    }

                    weeklyHours += hrs;

                    row += `<td class="p-2 text-center">
                        <div class="p-1.5 rounded-xl border text-[11px] font-medium shadow-sm ${badgeColor}">
                            <div class="font-bold">${badgeText}</div>
                            <div class="text-[10px] opacity-90 mt-0.5">${timeSubtext}</div>
                        </div>
                    </td>`;
                });

                row += `<td class="p-3 text-center font-semibold text-xs">${weeklyHours} hrs</td></tr>`;
                tbody.innerHTML += row;
            });

            const pending = requests.filter(r => r.status === 'Pending').length;
            const badge = document.getElementById('pending-badge');
            if (badge) badge.innerText = pending;
        }

        function navigateWeek(dir) {
            currentViewDate.setDate(currentViewDate.getDate() + (dir * 7));
            renderWeekBoard();
        }

        function jumpToToday() {
            currentViewDate = new Date();
            initWeekStart();
            renderWeekBoard();
        }

        function renderMonthView() {
            const grid = document.getElementById('month-calendar-grid');
            if (!grid) return;
            grid.innerHTML = '';
            const year = currentMonthDate.getFullYear();
            const month = currentMonthDate.getMonth();
            document.getElementById('current-month-label').innerText = currentMonthDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

            const lastDay = new Date(year, month + 1, 0).getDate();
            for (let day = 1; day <= lastDay; day++) {
                const d = new Date(year, month, day);
                if (d.getDay() === 0 || d.getDay() === 6) continue;
                
                const y = d.getFullYear();
                const m = String(d.getMonth() + 1).padStart(2, '0');
                const dayStr = String(d.getDate()).padStart(2, '0');
                const dateStr = `${y}-${m}-${dayStr}`;

                const dayRequests = requests.filter(r => r.status === 'Approved' && dateStr >= r.start && dateStr <= r.end);

                let requestsHtml = '';
                if (dayRequests.length > 0) {
                    dayRequests.forEach(req => {
                        let timeInfo = req.timeFrom && req.timeTo ? `(${req.timeFrom}-${req.timeTo})` : '(Full Day)';
                        if (req.type === 'Split Shift') timeInfo = `(${req.site1}: ${req.time1} | ${req.site2}: ${req.time2})`;
                        
                        let badgeBg = 'bg-blue-50 text-blue-700 border-blue-200';
                        if (req.type === 'Sick') badgeBg = 'bg-rose-50 text-rose-700 border-rose-200';
                        if (req.type === 'School') badgeBg = 'bg-purple-50 text-purple-700 border-purple-200';
                        if (req.type === 'Split Shift') badgeBg = 'bg-indigo-50 text-indigo-700 border-indigo-200';

                        requestsHtml += `<div class="mt-1 p-1 rounded border text-[10px] font-semibold ${badgeBg}">
                            👤 ${req.name}: <strong>${req.type}</strong><br><span class="text-[9px] opacity-80">${timeInfo}</span>
                        </div>`;
                    });
                } else {
                    requestsHtml = `<div class="text-[10px] text-slate-400 mt-1 italic">No time-off requests</div>`;
                }

                grid.innerHTML += `<div class="bg-slate-50 p-3 rounded-xl border min-h-[110px] flex flex-col justify-between">
                    <div>
                        <div class="font-bold text-xs text-indigo-600">${d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' })}</div>
                        <div class="space-y-1 mt-1">${requestsHtml}</div>
                    </div>
                </div>`;
            }
        }
        function navigateMonth(dir) { currentMonthDate.setMonth(currentMonthDate.getMonth() + dir); renderMonthView(); }
        function jumpToCurrentMonth() { currentMonthDate = new Date(); renderMonthView(); }

        function populateRequestDropdown() {
            const select = document.getElementById('req-person');
            if (!select) return;
            select.innerHTML = '<option value="">Select staff...</option>';
            staffList.forEach(s => {
                select.innerHTML += `<option value="${s.name}">${s.name} (${s.site})</option>`;
            });
        }

        async function handleRequestSubmit(e) {
            e.preventDefault();
            const type = document.getElementById('req-type').value;
            let entry = {
                id: 'req_' + Date.now(),
                name: document.getElementById('req-person').value,
                type: type,
                start: document.getElementById('req-start').value,
                end: document.getElementById('req-end').value,
                status: 'Pending'
            };

            if (type === 'Split Shift') {
                entry.site1 = document.getElementById('req-site-1').value;
                entry.time1 = document.getElementById('req-time-1').value;
                entry.site2 = document.getElementById('req-site-2').value;
                entry.time2 = document.getElementById('req-time-2').value;
            } else {
                entry.timeFrom = document.getElementById('req-time-from').value;
                entry.timeTo = document.getElementById('req-time-to').value;
            }

            requests.push(entry);
            await saveCloudData();
            alert('Request submitted successfully!');
            e.target.reset();
            switchView('week');
        }

        function renderManagerQueue() {
            const tbody = document.getElementById('manager-table-body');
            if (!tbody) return;
            tbody.innerHTML = '';
            requests.forEach(r => {
                let details = `${r.timeFrom || '-'} to ${r.timeTo || '-'}`;
                if (r.type === 'Split Shift') {
                    details = `${r.site1} (${r.time1}) & ${r.site2} (${r.time2})`;
                }
                tbody.innerHTML += `<tr class="border-b">
                    <td class="py-3 px-2 font-semibold">${r.name}</td>
                    <td class="py-3 px-2 text-xs"><strong>${r.type}</strong><br>${r.start} to ${r.end}</td>
                    <td class="py-3 px-2 text-xs text-slate-600">${details}</td>
                    <td class="py-3 px-2"><span class="px-2 py-0.5 rounded-full text-xs font-bold ${r.status === 'Pending' ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-800'}">${r.status}</span></td>
                    <td class="py-3 px-2 text-right space-x-1">
                        ${r.status === 'Pending' ? `<button onclick="updateReq('${r.id}', 'Approved')" class="bg-emerald-600 text-white px-2 py-1 rounded text-xs">Approve</button><button onclick="updateReq('${r.id}', 'Denied')" class="bg-rose-600 text-white px-2 py-1 rounded text-xs">Deny</button>` : ''}
                        <button onclick="deleteReq('${r.id}')" class="text-rose-600 text-xs ml-2 font-medium">Delete</button>
                    </td>
                </tr>`;
            });
        }

        async function updateReq(id, status) {
            const req = requests.find(r => r.id === id);
            if (req) { 
                req.status = status; 
                await saveCloudData();
                renderManagerQueue(); 
                renderWeekBoard(); 
            }
        }

        async function deleteReq(id) {
            requests = requests.filter(r => r.id !== id);
            await saveCloudData();
            renderManagerQueue();
            renderWeekBoard();
        }

        function renderSetupStaff() {
            const list = document.getElementById('setup-staff-list');
            if (!list) return;
            list.innerHTML = '';
            staffList.forEach((s, idx) => {
                list.innerHTML += `<div class="flex justify-between items-center bg-slate-50 p-2.5 rounded-xl border">
                    <div><strong>${s.name}</strong> (${s.site})<br><span class="text-xs text-slate-500">${s.hours}</span></div>
                    <button onclick="removeStaff(${idx})" class="text-rose-600 text-xs font-semibold">Remove</button>
                </div>`;
            });
        }

        async function handleAddStaff(e) {
            e.preventDefault();
            staffList.push({
                name: document.getElementById('new-staff-name').value,
                site: document.getElementById('new-staff-site').value,
                hours: document.getElementById('new-staff-hours').value,
                pool: document.getElementById('new-staff-pool').checked
            });
            await saveCloudData();
            e.target.reset();
            populateRequestDropdown();
            renderSetupStaff();
            alert('Employee added!');
        }

        async function removeStaff(idx) {
            staffList.splice(idx, 1);
            await saveCloudData();
            populateRequestDropdown();
            renderSetupStaff();
            renderWeekBoard();
        }
    </script>
</body>
</html>
